# =============================================================================
# PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES (Vercel + Neon)
# =============================================================================

# Node Environment
NODE_ENV=production

# Application Port (local development)
PORT=4000

# -----------------------------------------------------------------------------
# Neon PostgreSQL Connection Strings (Prisma)
# -----------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string (-pooler) used by Prisma Client for serverless runtime queries
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct unpooled connection string used for 'npm run prisma:migrate:deploy'
DIRECT_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT_SECRET: Secure 256-bit random string for signing JWT tokens
JWT_SECRET="replace-with-a-secure-random-256-bit-key-in-production"
JWT_EXPIRATION="7d"

# CORS Origin: Production Vercel domain
CORS_ORIGIN="https://your-project.vercel.app"

# -----------------------------------------------------------------------------
# Permanent Cloud Attachment Storage (Vercel Blob)
# -----------------------------------------------------------------------------
# Automatically injected when connecting a Vercel Blob store in the Vercel Dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# Local fallback directory for serverless execution
ATTACHMENTS_STORAGE_DIR="/tmp/attachments"

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Relative API path on the same Vercel domain
VITE_API_BASE_URL="/api"

# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
