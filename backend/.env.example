# Application Port
PORT=4000

# Node Environment
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/inbox_ticketing?schema=public"

# JWT Authentication Secret & Expiration
JWT_SECRET="replace-with-a-secure-random-256-bit-key-in-production"
JWT_EXPIRATION="7d"

# Allowed CORS Origins (Frontend Vite Server)
CORS_ORIGIN="http://localhost:3000"
