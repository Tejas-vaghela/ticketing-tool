# Application Port
PORT=4000

# Node Environment
NODE_ENV=production

# PostgreSQL Connection Strings (Prisma)
# In production on Neon:
# DATABASE_URL: Neon pooled connection string (-pooler) for serverless app runtime
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Neon direct connection string (unpooled) for prisma migrate deploy
DIRECT_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret & Expiration
JWT_SECRET="replace-with-a-secure-random-256-bit-key-in-production"
JWT_EXPIRATION="7d"

# Allowed CORS Origins (Frontend Vite Server or Vercel domain)
CORS_ORIGIN="https://your-project.vercel.app"

# Attachments Storage Directory (local fallback, /tmp on Vercel)
ATTACHMENTS_STORAGE_DIR="/tmp/attachments"

# Permanent Cloud Storage (Optional / Recommended for Vercel Serverless)
# In Vercel, created via "Storage -> Blob" and automatically provisioned
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"
