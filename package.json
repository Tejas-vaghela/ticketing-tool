{
  "name": "inbox-ticketing-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm --prefix backend run prisma:generate",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate:deploy": "npm --prefix backend run prisma:migrate:deploy",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run prisma:generate && npm run build:backend && npm run build:frontend"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.8"
  }
}
