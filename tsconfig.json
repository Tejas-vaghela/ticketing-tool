{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "baseUrl": "./",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": ["api/**/*", "backend/src/**/*"]
}
